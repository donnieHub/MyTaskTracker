<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <!--
          Метки, по которым потом удобно фильтровать в Grafana:
          {app="user-service"} или {app="user-service", level="ERROR"}
        -->
        <labels>
            app = user-service
            host = ${HOSTNAME}
            level = %level
        </labels>

        <message>
            <pattern>%-5level [%thread] %logger{36} - %msg%n%ex</pattern>
        </message>

        <http>
            <!--
              LOKI_URL берётся из переменной окружения ОС (не Spring property).
              Если переменной нет (запуск из IDEA) - используется значение по умолчанию,
              которое подходит для локального запуска, т.к. порт Loki проброшен на хост.
            -->
            <url>${LOKI_URL:-http://localhost:3100/loki/api/v1/push}</url>
        </http>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>